---
import { getCollection } from "astro:content";
import "../styles/reset.css";
import "../styles/style.css";

const compareByOptionalOrder = (
  a: { data: { order?: number } },
  b: { data: { order?: number } },
) => {
  const orderA = a.data.order;
  const orderB = b.data.order;

  if (orderA == null && orderB == null) return 0;
  if (orderA == null) return 1;
  if (orderB == null) return -1;
  return orderA - orderB;
};

const features = (await getCollection("features"))
  .sort(compareByOptionalOrder)
  .map((entry) => entry.data);

const plans = (await getCollection("pricing"))
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry) => entry.data);

const reviews = (await getCollection("reviews"))
  .sort(compareByOptionalOrder)
  .map((entry) => entry.data);
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>WeeklyPost</title>
    <script is:inline src="https://cdn.tailwindcss.com"></script>
  </head>

  <body
    class="font-serif text-[#2a241c] bg-gradient-to-b from-[#f6efe3] to-[#f1e3cf] leading-[1.45]"
  >
    <a
      class="absolute -left-[9999px] top-3 bg-white text-black px-[10px] py-2 rounded-[10px] z-[999] focus:left-3"
      href="#main">Skip to content</a
    >

    <header
      class="sticky top-0 z-50 bg-[rgba(246,239,227,0.95)] border-b-2 border-[rgba(42,36,28,0.35)]"
      id="top"
    >
      <input id="nav-open" type="checkbox" class="peer hidden" />

      <div
        class="max-w-[1120px] mx-auto px-4 sm:px-8 flex items-center justify-between gap-4 py-3"
      >
        <a
          class="inline-flex items-center gap-[10px] no-underline text-[#2a241c]"
          href="#top"
          aria-label="Home"
        >
          <span class="font-sans font-[650] text-base">WeeklyPost</span>
        </a>

        <nav
          class="hidden md:flex gap-[14px] items-center flex-wrap"
          aria-label="Primary"
        >
          <a class="font-sans text-[#6a5b49] no-underline text-sm px-[10px] py-[6px] rounded-xl hover:bg-white/45 hover:text-[#2a241c]" href="#platform">Platform</a>
          <a class="font-sans text-[#6a5b49] no-underline text-sm px-[10px] py-[6px] rounded-xl hover:bg-white/45 hover:text-[#2a241c]" href="#features">Features</a>
          <a class="font-sans text-[#6a5b49] no-underline text-sm px-[10px] py-[6px] rounded-xl hover:bg-white/45 hover:text-[#2a241c]" href="#pricing">Pricing</a>
          <a class="font-sans text-[#6a5b49] no-underline text-sm px-[10px] py-[6px] rounded-xl hover:bg-white/45 hover:text-[#2a241c]" href="#reviews">Reviews</a>
        </nav>

        <div class="hidden md:flex gap-[10px] items-center">
          <a class="inline-flex items-center justify-center px-[14px] py-[10px] rounded-[14px] no-underline text-sm font-sans whitespace-nowrap border border-[rgba(42,36,28,0.16)] bg-white/[.52] text-[#2a241c]" href="#pricing">See pricing</a>
          <a class="inline-flex items-center justify-center px-[14px] py-[10px] rounded-[14px] no-underline text-sm font-sans whitespace-nowrap border border-transparent bg-[rgba(42,36,28,0.92)] text-[#f7f0e4] hover:brightness-105" href="#get-started">Get the demo</a>
        </div>

        <label
          for="nav-open"
          class="md:hidden flex flex-col justify-center gap-[5px] cursor-pointer p-1 rounded-lg hover:bg-white/40"
          aria-label="Toggle menu"
        >
          <span class="block w-5 h-[2px] rounded bg-[#2a241c]"></span>
          <span class="block w-5 h-[2px] rounded bg-[#2a241c]"></span>
          <span class="block w-5 h-[2px] rounded bg-[#2a241c]"></span>
        </label>
      </div>

      <div
        class="hidden peer-checked:flex flex-col md:hidden border-t border-[rgba(42,36,28,0.16)] px-4 py-4 gap-1 bg-[rgba(246,239,227,0.97)]"
      >
        <a class="font-sans text-[#6a5b49] no-underline text-base px-3 py-2 rounded-xl hover:bg-white/60 hover:text-[#2a241c]" href="#platform" onclick="document.getElementById('nav-open').checked = false">Platform</a>
        <a class="font-sans text-[#6a5b49] no-underline text-base px-3 py-2 rounded-xl hover:bg-white/60 hover:text-[#2a241c]" href="#features" onclick="document.getElementById('nav-open').checked = false">Features</a>
        <a class="font-sans text-[#6a5b49] no-underline text-base px-3 py-2 rounded-xl hover:bg-white/60 hover:text-[#2a241c]" href="#pricing" onclick="document.getElementById('nav-open').checked = false">Pricing</a>
        <a class="font-sans text-[#6a5b49] no-underline text-base px-3 py-2 rounded-xl hover:bg-white/60 hover:text-[#2a241c]" href="#reviews" onclick="document.getElementById('nav-open').checked = false">Reviews</a>
      </div>
    </header>

    <main id="main">
      <section
        class="pt-12 pb-8 md:pt-24 md:pb-16 bg-[rgba(255,255,255,0.22)] border-b border-[rgba(42,36,28,0.10)]"
        id="get-started"
      >
        <div class="max-w-[1120px] mx-auto px-4 sm:px-8 grid grid-cols-1 md:grid-cols-[1.1fr_0.9fr] gap-6 items-center">
          <div>
            <p class="text-[13px] tracking-[0.18em] uppercase text-[#6a5b49]">Weekly, calm, curated</p>
            <h1 class="mt-2 text-[32px] sm:text-[42px] md:text-[48px] leading-[1.05]">Turn saved links into a beautiful email newspaper.</h1>
            <p class="mt-3 text-[17px] text-[#6a5b49] max-w-[64ch]">Save anything you find interesting during the week — articles, videos, posts — then receive a clean, customizable digest in your inbox.</p>
            <div class="mt-[14px] flex gap-3 flex-wrap">
              <a class="inline-flex items-center justify-center px-[14px] py-[10px] rounded-[14px] no-underline text-sm font-sans whitespace-nowrap border border-transparent bg-[rgba(42,36,28,0.92)] text-[#f7f0e4] hover:brightness-105" href="#pricing">Start free</a>
              <a class="inline-flex items-center justify-center px-[14px] py-[10px] rounded-[14px] no-underline text-sm font-sans whitespace-nowrap border border-[rgba(42,36,28,0.16)] bg-white/[.52] text-[#2a241c]" href="#platform">How it works</a>
            </div>
          </div>
        </div>
      </section>

      <section class="py-12 md:py-24" id="platform">
        <div class="max-w-[1120px] mx-auto px-4 sm:px-8">
          <div class="grid gap-2 mb-[18px]">
            <h2 class="text-[26px] md:text-[32px] leading-[1.1]">Platform</h2>
            <p class="text-[#6a5b49]">Four actions. One simple loop. Save → curate → deliver → repeat.</p>
          </div>

          <div class="grid gap-[18px] grid-cols-1 sm:grid-cols-2 lg:grid-cols-[repeat(auto-fit,minmax(240px,1fr))]">
            <article class="border border-[rgba(42,36,28,0.16)] bg-white/[.45] rounded-[16px] p-4">
              <h3 class="text-[18px]">Save links in one tap</h3>
              <p class="mt-2 text-[#6a5b49]">Drop anything into your inbox: YouTube, articles, posts, threads.</p>
            </article>

            <article class="border border-[rgba(42,36,28,0.16)] bg-white/[.45] rounded-[16px] p-4">
              <h3 class="text-[18px]">Keep a static source list</h3>
              <p class="mt-2 text-[#6a5b49]">Maintain a curated sources list you can edit anytime.</p>
            </article>

            <article class="border border-[rgba(42,36,28,0.16)] bg-white/[.45] rounded-[16px] p-4">
              <h3 class="text-[18px]">Auto-organize with light filters</h3>
              <p class="mt-2 text-[#6a5b49]">Basic rules keep every issue readable and focused.</p>
            </article>

            <article class="border border-[rgba(42,36,28,0.16)] bg-white/[.45] rounded-[16px] p-4">
              <h3 class="text-[18px]">Receive a calm email newspaper</h3>
              <p class="mt-2 text-[#6a5b49]">A few pages, max — delivered on schedule.</p>
            </article>
          </div>
        </div>
      </section>

      <section
        class="py-12 md:py-24 bg-white/[.12] border-y border-[rgba(42,36,28,0.16)]"
        id="features"
      >
        <div class="max-w-[1120px] mx-auto px-4 sm:px-8">
          <div class="grid gap-2 mb-[18px]">
            <h2 class="text-[26px] md:text-[32px] leading-[1.1]">Features</h2>
            <p class="text-[#6a5b49]">Managed in TinaCMS — add a markdown file to add a new feature card.</p>
          </div>

          <div class="grid gap-[18px] grid-cols-1 sm:grid-cols-2 lg:grid-cols-3">
            {features.map((feature) => (
              <article class="border border-[rgba(42,36,28,0.16)] bg-white/[.45] rounded-[16px] p-4">
                <h3 class="text-[18px]">{feature.title}</h3>
                <p class="mt-2 text-[#6a5b49]">{feature.description}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="py-12 md:py-24" id="pricing">
        <div class="max-w-[1120px] mx-auto px-4 sm:px-8">
          <div class="grid gap-2 mb-[18px]">
            <h2 class="text-[26px] md:text-[32px] leading-[1.1]">Pricing</h2>
            <p class="text-[#6a5b49]">Each plan is managed in TinaCMS and rendered automatically.</p>
          </div>

          <div class="grid gap-[18px] grid-cols-1 sm:grid-cols-2 lg:grid-cols-3">
            {plans.map((plan) => (
              <article class={`border rounded-[16px] p-4 ${plan.highlight ? "border-[rgba(42,36,28,0.22)] bg-white/[.65]" : "border-[rgba(42,36,28,0.16)] bg-white/[.45]"}`}>
                <div>
                  <h3 class="text-[18px]">{plan.name}</h3>
                  <p class="text-[#6a5b49]">{plan.subtitle}</p>
                </div>
                <p class="my-3 flex items-baseline gap-[6px]">
                  <span class="font-sans font-[800] text-[36px]">{plan.price}</span>
                  <span class="font-sans text-[#6a5b49] text-sm">{plan.period}</span>
                </p>
                <ul class="p-0 mb-3 grid gap-2 text-[#6a5b49]">
                  {plan.features.map((item) => (
                    <li class="flex items-start gap-[10px]">
                      <span class="text-[rgba(42,36,28,0.7)]" aria-hidden="true">✓</span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
                <a class={`inline-flex items-center justify-center px-[14px] py-[10px] rounded-[14px] no-underline text-sm font-sans whitespace-nowrap ${plan.highlight ? "border border-transparent bg-[rgba(42,36,28,0.92)] text-[#f7f0e4] hover:brightness-105" : "border border-[rgba(42,36,28,0.16)] bg-white/[.52] text-[#2a241c]"}`} href={plan.ctaHref}>{plan.ctaLabel}</a>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section
        class="py-12 md:py-24 bg-white/[.12] border-y border-[rgba(42,36,28,0.16)]"
        id="reviews"
      >
        <div class="max-w-[1120px] mx-auto px-4 sm:px-8">
          <div class="grid gap-2 mb-[18px]">
            <h2 class="text-[26px] md:text-[32px] leading-[1.1]">Reviews</h2>
            <p class="text-[#6a5b49]">Add or edit reviews directly from TinaCMS.</p>
          </div>

          <div class="grid gap-[18px] grid-cols-1 sm:grid-cols-2 lg:grid-cols-3">
            {reviews.map((review) => (
              <article class="border border-[rgba(42,36,28,0.16)] bg-white/[.45] rounded-xl p-4">
                <blockquote class="m-0 text-[19px] leading-[1.18] pl-3 border-l-2 border-[rgba(42,36,28,0.22)]">“{review.comment}”</blockquote>
                <p class="mt-3 text-[#2a241c] font-sans text-sm uppercase tracking-[0.04em]">{review.author}</p>
              </article>
            ))}
          </div>
        </div>
      </section>
    </main>

    <footer class="pt-[22px] pb-7 border-t border-[rgba(42,36,28,0.16)]">
      <div class="max-w-[1120px] mx-auto px-4 sm:px-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 flex-wrap">
        <p class="text-[#6a5b49]">© 2026 WeeklyPost. All rights reserved.</p>
        <div class="flex gap-[14px] flex-wrap font-sans text-[13px]">
          <a class="text-[#6a5b49] no-underline hover:text-[#2a241c]" href="#platform">Platform</a>
          <a class="text-[#6a5b49] no-underline hover:text-[#2a241c]" href="#features">Features</a>
          <a class="text-[#6a5b49] no-underline hover:text-[#2a241c]" href="#pricing">Pricing</a>
          <a class="text-[#6a5b49] no-underline hover:text-[#2a241c]" href="#reviews">Reviews</a>
        </div>
      </div>
    </footer>

    <div
      id="newguy-widget"
      class="group fixed bottom-6 right-6 z-[9999] w-[80px] h-[80px] sm:w-[120px] sm:h-[120px] cursor-pointer"
    >
      <div
        class="absolute bottom-full right-0 mb-3 w-[210px] opacity-0 group-hover:opacity-100 translate-y-1 group-hover:translate-y-0 transition-all duration-200"
      >
        <div class="bg-[#2a241c] text-[#f7f0e4] text-sm font-sans rounded-2xl px-4 py-3 shadow-lg leading-snug">
          Hey! Have you tried your free weekly digest yet?
          <a
            href="#pricing"
            class="mt-2 flex items-center justify-center w-full px-3 py-[7px] rounded-xl border border-[rgba(42,36,28,0.16)] bg-[#f7f0e4] text-[#2a241c] text-xs font-sans font-[600] no-underline hover:bg-white transition-colors"
          >
            See pricing →
          </a>
          <div class="absolute bottom-[-7px] right-8 w-0 h-0 border-l-[7px] border-l-transparent border-r-[7px] border-r-transparent border-t-[8px] border-t-[#2a241c]"></div>
        </div>
      </div>

      <img
        id="newguy-img"
        class="absolute inset-0 w-full h-full object-contain"
        src="/assets/newguy.png"
        alt=""
        aria-hidden="true"
      />
    </div>
  </body>
</html>
